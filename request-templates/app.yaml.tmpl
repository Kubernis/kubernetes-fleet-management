# Generated by Port's "Deploy an application" action — do not edit by hand.
#
# A deployment DECLARATION, not a deployment. It says which service should run
# in which environment, from which repository. The manifests themselves live in
# the team's own repo at the path below; nothing about how ArgoCD is configured
# is expressed here.
#
# The generated Application lands in the environment's own ArgoCD project, so it
# can only pull from that team's repositories and can only deploy into that one
# namespace. Those limits are already enforced — see charts/tenant.
app:
  name: ${APP_NAME}
  team: ${APP_TEAM}
  environment: ${APP_ENVIRONMENT}
  repo: ${APP_REPO}
  path: ${APP_PATH}
  targetRevision: ${APP_TARGET_REVISION}

meta:
  requestedBy: ${REQUESTED_BY}
  requestedAt: ${REQUESTED_AT}
  portRunId: ${PORT_RUN_ID}
