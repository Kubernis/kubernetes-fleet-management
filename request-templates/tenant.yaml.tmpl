# Generated by Port's "Request an environment" action — do not edit by hand.
#
# Changing a value here re-provisions the tenant on the next sync. To resize,
# raise a new request; to decommission, delete this directory.
#
# What this file does NOT contain is the point: no namespace manifest, no quota
# numbers, no ArgoCD Application, no sync policy. Those live in charts/tenant,
# owned by the platform team, and every tenant inherits whatever it says today.
tenant:
  name: ${TENANT_NAME}
  team: ${TENANT_TEAM}
  stage: ${TENANT_STAGE}
  tier: ${TENANT_TIER}
  requestedBy: ${REQUESTED_BY}

# Provenance. Written once at creation and never reconciled — it answers
# "who asked for this, when, and under which Port run" during review.
meta:
  requestedAt: ${REQUESTED_AT}
  portRunId: ${PORT_RUN_ID}
